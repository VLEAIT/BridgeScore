{
  "_metadata": {
    "description": "District-level FSV multipliers applied to Sarkaari Mool (government assessed land value) to correct for systematic undervaluation. Sarkaari Mool understates true market value by 3-5x in most districts. Multiplier calibrated from NRB concessional lending data and Nepal agricultural census 2021/22.",
    "formula": "FSV = sarkaari_mool * district_multiplier * land_grade_factor * 0.60",
    "ltv_ratio": 0.60,
    "last_updated": "2026-04",
    "source": "Calibrated from NSO 2022, NRB Unified Directive 2081, author estimates",
    "zones": {
      "terai": "Flatland districts — highest multiplier",
      "hill": "Hilly districts — medium multiplier",
      "mountain": "Himalayan districts — lowest multiplier"
    }
  },
